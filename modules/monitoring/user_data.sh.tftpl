#!/bin/bash
set -euxo pipefail

# Removed 'curl' to prevent conflicts with preinstalled 'curl-minimal'
dnf install -y python3 python3-pip tar gzip
python3 -m venv /opt/greenqueue-venv
/opt/greenqueue-venv/bin/pip install --no-cache-dir boto3 prometheus-client

mkdir -p /opt/greenqueue /etc/prometheus /var/lib/prometheus
cat > /opt/greenqueue/grafana_setup.sh <<'GRAFANA_SETUP_EOF'
${grafana_setup}
GRAFANA_SETUP_EOF
chmod 0755 /opt/greenqueue/grafana_setup.sh
cat > /opt/greenqueue/greenqueue-dashboard.json <<'DASHBOARD_SOURCE_EOF'
${dashboard_json}
DASHBOARD_SOURCE_EOF

cat > /opt/greenqueue/dynamodb_exporter.py <<'PYEOF'
${exporter_py}
PYEOF

cat > /etc/systemd/system/greenqueue-exporter.service <<EOF
[Unit]
Description=GreenQueue DynamoDB Prometheus exporter
After=network-online.target
Wants=network-online.target

[Service]
Environment=AWS_DEFAULT_REGION=${region}
Environment=JOBS_TABLE=${jobs_table}
Environment=GRID_TABLE=${grid_table}
Environment=QUEUE_URL=${queue_url}
Environment=POLL_SECONDS=30
ExecStart=/opt/greenqueue-venv/bin/python /opt/greenqueue/dynamodb_exporter.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

PROM_VERSION=2.55.1
curl -fSL "https://github.com/prometheus/prometheus/releases/download/v$${PROM_VERSION}/prometheus-$${PROM_VERSION}.linux-amd64.tar.gz" -o /tmp/prometheus.tar.gz
tar -xzf /tmp/prometheus.tar.gz -C /tmp
install -m 0755 "/tmp/prometheus-$${PROM_VERSION}.linux-amd64/prometheus" /usr/local/bin/prometheus
install -m 0755 "/tmp/prometheus-$${PROM_VERSION}.linux-amd64/promtool" /usr/local/bin/promtool
useradd --system --no-create-home --shell /sbin/nologin prometheus || true
chown -R prometheus:prometheus /var/lib/prometheus

cat > /etc/prometheus/prometheus.yml <<'EOF'
global:
  scrape_interval: 30s
  evaluation_interval: 30s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:9090"]
  - job_name: greenqueue-dynamodb
    static_configs:
      - targets: ["127.0.0.1:9108"]
EOF

chown -R prometheus:prometheus /etc/prometheus /var/lib/prometheus

cat > /etc/systemd/system/prometheus.service <<'EOF'
[Unit]
Description=Prometheus monitoring system
After=network-online.target
Wants=network-online.target

[Service]
User=prometheus
Group=prometheus
ExecStart=/usr/local/bin/prometheus --config.file=/etc/prometheus/prometheus.yml --storage.tsdb.path=/var/lib/prometheus --storage.tsdb.retention.time=3d --web.listen-address=0.0.0.0:9090
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now greenqueue-exporter prometheus
/opt/greenqueue/grafana_setup.sh